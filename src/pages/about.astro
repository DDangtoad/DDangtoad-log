---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="About" description="DDangtoad, Kim Chae Eun의 학력, 수상 및 활동 기록입니다.">
  <main id="main-content" class="content-shell about-page">
    <header class="profile-header">
      <img src={`${base}/images/profile-toad.png`} width="78" height="78" alt="DDangtoad 캐릭터" />
      <div>
        <p class="eyebrow">ABOUT</p>
        <h1>DDangtoad</h1>
        <p class="real-name">Kim Chae Eun</p>
      </div>
    </header>

    <div class="profile-sections">
      <section aria-labelledby="education-title">
        <p class="index">01</p>
        <div>
          <h2 id="education-title">Education</h2>
          <ul>
            <li><time>2024.03 — Present</time><strong>조선대학교 AI·SW학부 정보보안전공</strong></li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="awards-title">
        <p class="index">02</p>
        <div>
          <h2 id="awards-title">Awards</h2>
          <ul>
            <li><time>2026</time><strong>DEF CON 34 CTF</strong><small>Finalist</small></li>
            <li><time>2026</time><strong>호남IS해커톤</strong><small>우수상</small></li>
            <li><time>2025</time><strong>호남지역 정보보호 해커톤 대회</strong><small>전남정보보호지원센터장상</small></li>
            <li><time>2025</time><strong>제1회 조선대학교 SW중심대학 정보보안 경진대회</strong><small>은상</small></li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="activities-title">
        <p class="index">03</p>
        <div>
          <h2 id="activities-title">Activities</h2>
          <ul>
            <li><time>2026.03 — Present</time><strong>조선대학교 인터넷 침해사고 대응팀 스터디원</strong><small>교내 사이트 취약점 제보 활동</small></li>
            <li><time>2025.09 — 2026.04</time><strong>HSPACE Knights Frontier 1기</strong></li>
            <li><time>2025.03 — 2025.09</time><strong>WhiteHat School 3기</strong></li>
            <li><time>2025.01 — Present</time><strong>HackerLogin 운영진</strong><small>조선대학교 교내 보안 동아리</small></li>
          </ul>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .profile-header { display: flex; align-items: center; gap: 24px; padding: 24px 0 70px; }
  .profile-header img { width: 110px; height: 110px; padding: 10px; border: 1px solid var(--line); object-fit: contain; image-rendering: pixelated; }
  h1 { margin: 8px 0 0; font-size: 3.6rem; line-height: 1; }
  .real-name { margin: 9px 0 0; color: var(--muted); font: .72rem var(--mono); letter-spacing: .08em; }
  .profile-sections { border-top: 1px solid var(--line); }
  section { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 28px; padding: 38px 0; border-bottom: 1px solid var(--line); }
  .index { margin: 5px 0 0; color: var(--cyan); font: .66rem var(--mono); }
  h2 { margin: 0 0 24px; font-size: 1.45rem; }
  ul { display: grid; gap: 24px; padding: 0; margin: 0; list-style: none; }
  li { display: grid; grid-template-columns: 160px minmax(0, 1fr); align-items: baseline; gap: 3px 22px; }
  time { color: var(--cyan); font: .64rem/1.35 var(--mono); }
  strong { font-size: .93rem; font-weight: 550; line-height: 1.35; }
  small { grid-column: 2; color: var(--muted); font-size: .78rem; line-height: 1.5; }
  @media (max-width: 640px) {
    .profile-header { align-items: flex-start; padding-top: 10px; }
    .profile-header img { width: 86px; height: 86px; }
    h1 { font-size: 2.5rem; }
    section { grid-template-columns: 36px minmax(0, 1fr); gap: 14px; }
    li { grid-template-columns: 1fr; gap: 5px; }
    small { grid-column: 1; }
  }
</style>
