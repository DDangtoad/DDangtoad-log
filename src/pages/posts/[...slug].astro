---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

type Props = { readonly post: CollectionEntry<"posts"> };

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="read-progress" data-read-progress aria-hidden="true"></div>
  <main id="main-content" class="content-shell article-page">
    <article>
      <header>
        <a class="back" href={`${base}/posts`}>← POSTS</a>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <div class="meta">
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("ko-KR")}</time>
          <ul class="tag-list" aria-label="태그">{post.data.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
        </div>
      </header>
      <div class="prose"><Content /></div>
    </article>
  </main>
</BaseLayout>

<script>
  const progress = document.querySelector<HTMLElement>("[data-read-progress]");
  function updateReadingProgress(): void {
    if (!progress) return;
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = scrollable <= 0 ? 1 : Math.min(1, window.scrollY / scrollable);
    progress.style.transform = `scaleX(${ratio})`;
  }
  updateReadingProgress();
  document.addEventListener("scroll", updateReadingProgress, { passive: true });
</script>

<style>
  .read-progress { position: fixed; z-index: 30; top: 0; right: 0; left: 0; height: 1px; transform: scaleX(0); transform-origin: left; background: var(--cyan); }
  .article-page { width: min(calc(100% - 40px), 760px); }
  header { padding: 20px 0 54px; border-bottom: 1px solid var(--line); }
  .back { color: var(--cyan); font: .68rem var(--mono); text-decoration: none; }
  h1 { margin: 26px 0 18px; font-size: 4rem; line-height: 1.08; }
  .lede { max-width: 640px; margin: 0; color: var(--muted); font-size: 1.02rem; }
  .meta { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 28px; }
  time { color: var(--muted); font: .65rem var(--mono); }
  .prose { padding-top: 52px; font-size: 1rem; line-height: 1.95; }
  .prose :global(h2), .prose :global(h3) { margin: 2.5em 0 .7em; line-height: 1.35; }
  .prose :global(h2) { padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .prose :global(a) { color: var(--cyan); text-underline-offset: 4px; }
  .prose :global(code) { padding: 2px 5px; background: var(--cyan-soft); color: var(--cyan); font: .88em var(--mono); }
  .prose :global(pre) { padding: 20px; overflow-x: auto; border: 1px solid var(--line); background: var(--surface); }
  .prose :global(pre code) { padding: 0; background: transparent; color: var(--text); }
  .prose :global(blockquote) { padding: 8px 18px; margin-inline: 0; border-left: 1px solid var(--cyan); color: var(--muted); }
  .prose :global(img) { max-width: 100%; border: 1px solid var(--line); }
  @media (max-width: 640px) {
    .article-page { width: min(calc(100% - 32px), 760px); }
    h1 { font-size: 2.8rem; }
    .meta { align-items: flex-start; flex-direction: column; gap: 10px; }
  }
</style>
